{
  "name": "resto-delivery-backend",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Premium Pizza — Telegram Bot + Mini App API + Admin API",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start:prod": "node src/index.js",
    "prestart": "node scripts/free-ports.js",
    "start": "concurrently -n \"BACKEND,MINIAPP,ADMIN,TUNNEL\" -c \"yellow,cyan,magenta,green\" \"npm:dev\" \"npm:dev:miniapp\" \"npm:dev:admin\" \"npm:tunnel\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "setup": "npm install && npm --prefix miniapp install && npm --prefix admin install && npm run db:push && npm run db:seed",
    "dev:miniapp": "npm --prefix miniapp run dev",
    "dev:admin": "npm --prefix admin run dev",
    "tunnel": "node scripts/tunnel.js",
    "settings": "node scripts/settings.js",
    "doctor": "node scripts/doctor.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prisma": "^5.22.0"
  }
}
