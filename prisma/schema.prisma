generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mijozlar
model User {
  id           Int      @id @default(autoincrement())
  telegramId   String   @unique
  firstName    String
  lastName     String?
  username     String?
  phone        String?
  languageCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("users")
}

/// Mahsulotlar (pizza, ichimlik va h.k.)
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  imageUrl    String   @default("")
  oldPrice    Int?
  newPrice    Int
  category    String   @default("Pizza")
  ingredients String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

/// Buyurtmalar
model Order {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items       Json // [{ productId, name, price, qty, imageUrl }]
  subtotal    Int     @default(0)
  deliveryFee Int     @default(0)
  discount    Int     @default(0)
  promoCode   String?
  total       Int

  deliveryType  DeliveryType  @default(DELIVERY)
  paymentMethod PaymentMethod @default(CASH)

  address   String?
  latitude  Float?
  longitude Float?
  phone     String?
  comment   String?

  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Promokodlar
model PromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  description    String    @default("")
  type           PromoType @default(PERCENT)
  value          Int // PERCENT uchun foiz, FIXED uchun so'm
  minOrderAmount Int       @default(0)
  maxDiscount    Int? // PERCENT uchun yuqori chegara
  usageLimit     Int? // null — cheksiz
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("promo_codes")
}

enum PromoType {
  PERCENT // foizli chegirma
  FIXED // belgilangan summa
}

enum DeliveryType {
  DELIVERY // Yetkazib berish
  PICKUP // Borib olish
}

enum PaymentMethod {
  CASH // Naqd
  CARD // Karta orqali
}

enum OrderStatus {
  PENDING // Kutilmoqda
  CONFIRMED // Tasdiqlandi
  PREPARING // Tayyorlanmoqda
  DELIVERING // Yo'lda
  DELIVERED // Yetkazildi
  CANCELLED // Bekor qilindi
}
