# ---------- BAZA (Neon PostgreSQL) ----------
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-shiny-grass-b2cuh36z-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-shiny-grass-b2cuh36z.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------- TELEGRAM BOT ----------
BOT_TOKEN="YOUR_BOT_TOKEN"
ADMIN_IDS="YOUR_TELEGRAM_ID"

# Mini App manzili.
# ngrok ishga tushgan bo'lsa, bot uni O'ZI topadi — bu yerni tahrirlash shart emas.
WEB_APP_URL="http://localhost:5173"
WEB_APP_PORT=5173
AUTO_NGROK=true

# ---------- SERVER ----------
PORT=5000
NODE_ENV=development

# Admin Panelga kirish paroli (o'zgartiring!)
ADMIN_PASSWORD="admin123"

# Brauzerda (Telegramsiz) test qilish uchun: true bo'lsa initData tekshiruvi o'chadi
ALLOW_BROWSER_DEV=true

# ---------- BIZNES SOZLAMALARI ----------
CURRENCY="so'm"
DELIVERY_FEE=15000
FREE_DELIVERY_FROM=150000
RESTAURANT_NAME="Resto"
