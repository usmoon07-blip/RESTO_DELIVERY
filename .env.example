# ---------- BAZA (Neon PostgreSQL) ----------
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-shiny-grass-b2cuh36z-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-shiny-grass-b2cuh36z.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------- TELEGRAM BOT ----------
BOT_TOKEN="YOUR_BOT_TOKEN"
ADMIN_IDS="YOUR_TELEGRAM_ID"

# Mini App manzili.
# Tunnel (Cloudflare yoki ngrok) ishga tushsa, bot manzilni O'ZI topadi —
# bu yerni tahrirlash shart emas.
WEB_APP_URL="http://localhost:5173"
WEB_APP_PORT=5173
AUTO_TUNNEL=true

# ---------- SERVER ----------
PORT=5000
NODE_ENV=development

# Admin Panelga kirish paroli (o'zgartiring!)
ADMIN_PASSWORD="admin123"

# Brauzerda (Telegramsiz) test qilish uchun: true bo'lsa initData tekshiruvi o'chadi
ALLOW_BROWSER_DEV=true

# ---------- BIZNES SOZLAMALARI ----------
CURRENCY="so'm"
DELIVERY_FEE=15000
FREE_DELIVERY_FROM=150000
RESTAURANT_NAME="Resto"

# ==========================================================
#  SERVERGA YUKLAGANDA (Render) — localhostda kerak emas
# ==========================================================

# Serverning tashqi manzili. Render buni RENDER_EXTERNAL_URL orqali
# O'ZI beradi, qo'lda yozish shart emas.
# Shu manzil bo'lsa — bot webhook rejimida ishlaydi (kompyuter kerak emas).
# PUBLIC_URL="https://resto-api.onrender.com"

# Mini App va Admin Panel manzillari (Vercel), vergul bilan.
# Faqat shu saytlarga API'ga murojaat qilishga ruxsat beriladi.
# CORS_ORIGINS="https://resto-mini.vercel.app,https://resto-admin.vercel.app"

# Serverda ALBATTA false bo'lsin — aks holda Telegramsiz ham kirish mumkin
# ALLOW_BROWSER_DEV=false
